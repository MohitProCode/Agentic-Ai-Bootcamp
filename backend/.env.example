APP_NAME=Personalized Learning Path API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=18

QUIZ_LLM_GENERATION_ENABLED=false
PLAN_LLM_ENRICHMENT_ENABLED=false
QUIZ_DEFAULT_QUESTION_COUNT=8
QUIZ_TARGET_TIME_SECONDS=45
LEARNING_PLAN_DEFAULT_WEEKS=4
